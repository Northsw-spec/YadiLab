    {"id": "sw-1", "label": "Switch 1", "kind": "switch", "x": 400, "y": 215, "zoneId": "zone-lab", "ports": [{"id": "ge1", "name": "GigabitEthernet1", "enabled": true, "ipv4": null}, {"id": "ge2", "name": "GigabitEthernet2", "enabled": true, "ipv4": null}]},
    {"id": "pc-2", "label": "Klient B", "kind": "host", "x": 740, "y": 235, "zoneId": "zone-lab", "ports": [{"id": "eth0", "name": "eth0", "enabled": true, "ipv4": "192.0.2.11/24"}]}
