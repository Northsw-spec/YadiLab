{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "outDir": "../dist-enterprise-import-test",
    "rootDir": ".."
  },
  "include": [
    "../core-model/src/generated/contracts.ts",
    "../enterprise-model/src/**/*.ts",
    "../enterprise-projection/src/**/*.ts",
    "../enterprise-import/src/**/*.ts",
    "../package-io/src/types.ts",
    "../package-io/src/zipjs-backend.ts",
    "../package-io/src/zipjs-types.d.ts"
  ]
}
