{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "outDir": "../dist-persistence-test",
    "rootDir": "..",
    "resolveJsonModule": true
  },
  "include": [
    "../capability-packs/src/**/*.ts",
    "../versioning/src/**/*.ts",
    "../app-config/branding.json",
    "../core-model/src/generated/contracts.ts",
    "../compiler/src/**/*.ts",
    "../engine/src/**/*.ts",
    "../observation-engine/src/**/*.ts",
    "../layout/src/types.ts",
    "../ui/src/canvas/**/*.ts",
    "../ui/src/browser/**/*.ts",
    "../package-io/src/**/*.ts"
  ]
}
