{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "outDir": "../dist-packageio-test",
    "rootDir": ".."
  },
  "include": [
    "../core-model/src/generated/contracts.ts",
    "../package-io/src/**/*.ts",
    "../package-io/src/**/*.d.ts"
  ]
}
