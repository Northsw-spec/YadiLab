{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true, "skipLibCheck": true,
    "outDir": "../dist-renderer-test", "rootDir": "..", "resolveJsonModule": true
  },
  "include": [
    "../core-model/src/generated/contracts.ts",
    "../asset-library/src/**/*.ts",
    "../ui/src/canvas/**/*.ts",
    "../renderer/src/**/*.ts"
  ]
}
