{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "outDir": "../dist-cli-test",
    "rootDir": "..",
    "resolveJsonModule": true
  },
  "include": [
    "../core-model/src/generated/contracts.ts",
    "../renderer/src/**/*.ts",
    "../ui/src/canvas/**/*.ts",
    "../asset-library/src/**/*.ts",
    "../versioning/src/**/*.ts",
    "../compiler/src/**/*.ts",
    "../engine/src/**/*.ts",
    "../cli/src/**/*.ts",
    "../cli/src/**/*.d.ts",
    "../catalog/builtin-catalog.json",
    "../package-io/src/**/*.ts",
    "../capability-packs/src/**/*.ts"
  ]
}
