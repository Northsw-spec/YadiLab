{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "outDir": "../dist-canvas-test",
    "rootDir": ".."
  },
  "include": [
    "../core-model/src/generated/contracts.ts",
    "../asset-library/src/**/*.ts",
    "../compiler/src/types.ts",
    "../ui/src/canvas/**/*.ts"
  ]
}
