{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:app:schema:scenario-source:0.1.0",
  "title": "Scenario Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatId",
    "schemaVersion",
    "scenarioId",
    "metadata",
    "requires",
    "zones",
    "resources",
    "connections",
    "tests",
    "findings",
    "objectives",
    "completion"
  ],
  "properties": {
    "formatId": {
      "const": "infrastructure-cyber-lab.scenario-source"
    },
    "schemaVersion": {
      "$ref": "#/$defs/semver"
    },
    "scenarioId": {
      "$ref": "#/$defs/id"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "language"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "briefing": {
          "type": "string"
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "profiles"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRequirement"
          },
          "uniqueItems": true
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRequirement"
          },
          "uniqueItems": true
        }
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/zone"
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/objective"
      }
    },
    "troubleshootingObjectives": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/troubleshootingObjective"
      }
    },
    "completion": {
      "$ref": "#/$defs/rule"
    },
    "hints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hint"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "canonicalSolution": {
      "$ref": "#/$defs/solution"
    },
    "layoutHints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layoutHint"
      }
    },
    "enterpriseOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineId",
        "baselineIdentity",
        "modelVersion",
        "projectionVersion",
        "sources"
      ],
      "properties": {
        "baselineId": {
          "$ref": "#/$defs/id"
        },
        "baselineIdentity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "modelVersion": {
          "$ref": "#/$defs/semver"
        },
        "projectionVersion": {
          "$ref": "#/$defs/semver"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "sha256",
              "mediaType"
            ],
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^src_[0-9a-f]{64}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "mediaType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              }
            }
          }
        }
      }
    },
    "faultOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseScenarioId",
        "baseScenarioHash",
        "overlayIdentity",
        "packLocks",
        "instances"
      ],
      "properties": {
        "baseScenarioId": {
          "$ref": "#/$defs/id"
        },
        "baseScenarioHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "overlayIdentity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "packLocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "packId",
              "version",
              "packIdentity"
            ],
            "properties": {
              "packId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
              },
              "version": {
                "$ref": "#/$defs/semver"
              },
              "packIdentity": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "instances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instanceId",
              "faultId",
              "faultVersion",
              "seed",
              "bindings"
            ],
            "properties": {
              "instanceId": {
                "$ref": "#/$defs/id"
              },
              "faultId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
              },
              "faultVersion": {
                "$ref": "#/$defs/semver"
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "bindings": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generatorId",
            "generatorVersion",
            "seed",
            "planIdentity"
          ],
          "properties": {
            "generatorId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
            },
            "generatorVersion": {
              "$ref": "#/$defs/semver"
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "planIdentity": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "truth": {
      "type": "string",
      "enum": [
        "TRUE",
        "FALSE",
        "UNKNOWN"
      ]
    },
    "hostStackProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 127
        }
      }
    },
    "hostStackSocket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "protocol",
        "localAddress",
        "localPort",
        "state"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "tcp",
            "udp"
          ]
        },
        "localAddress": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "localPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "remoteAddress": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "remotePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "state": {
          "type": "string",
          "enum": [
            "LISTEN",
            "BOUND",
            "SYN_SENT",
            "SYN_RECEIVED",
            "ESTABLISHED",
            "FIN_WAIT_1",
            "FIN_WAIT_2",
            "CLOSE_WAIT",
            "CLOSING",
            "LAST_ACK",
            "TIME_WAIT",
            "CLOSED",
            "UNKNOWN"
          ]
        },
        "processId": {
          "$ref": "#/$defs/id"
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 127
        }
      }
    },
    "hostStack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "processes",
        "sockets"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "processes": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/hostStackProcess"
          }
        },
        "sockets": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/hostStackSocket"
          }
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource"
      ],
      "properties": {
        "resource": {
          "$ref": "#/$defs/id"
        },
        "port": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      }
    },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "rules"
          ],
          "properties": {
            "op": {
              "const": "all"
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/rule"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "rules"
          ],
          "properties": {
            "op": {
              "const": "any"
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/rule"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "rule"
          ],
          "properties": {
            "op": {
              "const": "not"
            },
            "rule": {
              "$ref": "#/$defs/rule"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "target",
            "path",
            "value"
          ],
          "properties": {
            "op": {
              "const": "equals"
            },
            "target": {
              "$ref": "#/$defs/id"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "from",
            "to"
          ],
          "properties": {
            "op": {
              "const": "reachable"
            },
            "from": {
              "$ref": "#/$defs/id"
            },
            "to": {
              "$ref": "#/$defs/id"
            },
            "protocol": {
              "type": "string",
              "enum": [
                "tcp",
                "udp",
                "icmp",
                "any"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "subject",
            "group"
          ],
          "properties": {
            "op": {
              "const": "member_of"
            },
            "subject": {
              "$ref": "#/$defs/id"
            },
            "group": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "subject",
            "resource",
            "permission"
          ],
          "properties": {
            "op": {
              "const": "has_permission"
            },
            "subject": {
              "$ref": "#/$defs/id"
            },
            "resource": {
              "$ref": "#/$defs/id"
            },
            "permission": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "target",
            "service"
          ],
          "properties": {
            "op": {
              "const": "service_enabled"
            },
            "target": {
              "$ref": "#/$defs/id"
            },
            "service": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "test",
            "expected"
          ],
          "properties": {
            "op": {
              "const": "test_result"
            },
            "test": {
              "$ref": "#/$defs/id"
            },
            "expected": {
              "$ref": "#/$defs/truth"
            }
          }
        }
      ]
    },
    "sourceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "internet",
            "wan",
            "dmz",
            "lan",
            "server",
            "management",
            "security",
            "backup",
            "guest",
            "custom"
          ]
        },
        "parent": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mac": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{2}(?::[0-9A-Fa-f]{2}){5}$"
        },
        "mtu": {
          "type": "integer",
          "minimum": 1
        },
        "switchport": {
          "$ref": "#/$defs/switchport"
        }
      }
    },
    "neighbor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "protocol",
        "address",
        "state"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "targetResourceId": {
          "$ref": "#/$defs/id"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "ARP",
            "ND"
          ]
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "mac": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{2}(?::[0-9A-Fa-f]{2}){5}$"
        },
        "interface": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "type": "string",
          "enum": [
            "REACHABLE",
            "STALE",
            "INCOMPLETE",
            "FAILED",
            "UNKNOWN"
          ]
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "properties"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "zone": {
          "$ref": "#/$defs/id"
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interface"
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "neighbors": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/neighbor"
              }
            },
            "macTable": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/macTableEntry"
              }
            },
            "stp": {
              "$ref": "#/$defs/stpBridge"
            },
            "stpPorts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/stpPortEntry"
              }
            },
            "conntrack": {
              "$ref": "#/$defs/conntrackTable"
            },
            "isFirewall": {
              "type": "boolean"
            },
            "hostStack": {
              "$ref": "#/$defs/hostStack"
            }
          }
        },
        "asset": {
          "$ref": "#/$defs/sourceRequirement"
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "from",
        "to",
        "properties"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "network",
            "management",
            "trust",
            "authentication",
            "dependency",
            "data_flow"
          ]
        },
        "from": {
          "$ref": "#/$defs/endpoint"
        },
        "to": {
          "$ref": "#/$defs/endpoint"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "params"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "label": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "expectedInitial": {
          "$ref": "#/$defs/truth"
        },
        "expectedSolved": {
          "$ref": "#/$defs/truth"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "severity",
        "when"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "when": {
          "$ref": "#/$defs/rule"
        },
        "evidenceTests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "required",
        "condition"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "condition": {
          "$ref": "#/$defs/rule"
        }
      }
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "text"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "target",
            "path",
            "value"
          ],
          "properties": {
            "op": {
              "const": "set"
            },
            "target": {
              "$ref": "#/$defs/id"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "target",
            "path"
          ],
          "properties": {
            "op": {
              "const": "remove"
            },
            "target": {
              "$ref": "#/$defs/id"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    },
    "layoutHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/id"
        },
        "rank": {
          "type": "integer"
        },
        "order": {
          "type": "integer"
        },
        "preferredSide": {
          "type": "string",
          "enum": [
            "north",
            "east",
            "south",
            "west"
          ]
        },
        "parent": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "troubleshootingObservationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "const": "observation"
        },
        "category": {
          "type": "string",
          "enum": [
            "interface",
            "routing",
            "dns",
            "dhcp",
            "firewall",
            "service"
          ]
        },
        "targetId": {
          "$ref": "#/$defs/id"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "troubleshootingActiveProbeRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "const": "active_probe"
        },
        "category": {
          "type": "string",
          "enum": [
            "connectivity",
            "dns",
            "path"
          ]
        },
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "destinationId": {
          "$ref": "#/$defs/id"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "tcp",
            "udp",
            "icmp",
            "any"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "queryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "truth": {
          "type": "string",
          "enum": [
            "TRUE",
            "FALSE",
            "UNKNOWN"
          ]
        }
      }
    },
    "troubleshootingEvidenceRequirement": {
      "oneOf": [
        {
          "$ref": "#/$defs/troubleshootingObservationRequirement"
        },
        {
          "$ref": "#/$defs/troubleshootingActiveProbeRequirement"
        }
      ]
    },
    "troubleshootingObjective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "required",
        "evidenceOrder",
        "requirements"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "required": {
          "type": "boolean"
        },
        "evidenceOrder": {
          "type": "string",
          "enum": [
            "ordered",
            "unordered"
          ]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/troubleshootingEvidenceRequirement"
          }
        }
      }
    },
    "macTableEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mac",
        "interface"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "mac": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{2}(?::[0-9A-Fa-f]{2}){5}$"
        },
        "interface": {
          "$ref": "#/$defs/id"
        },
        "vlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        }
      }
    },
    "switchport": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "accessVlan"
          ],
          "properties": {
            "mode": {
              "const": "access"
            },
            "accessVlan": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4094
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "allowedVlans"
          ],
          "properties": {
            "mode": {
              "const": "trunk"
            },
            "allowedVlans": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4094,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4094
              }
            },
            "nativeVlan": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4094
            }
          }
        }
      ]
    },
    "stpBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "bridgeId",
        "rootBridgeId"
      ],
      "properties": {
        "protocol": {
          "type": "string",
          "enum": [
            "STP",
            "RSTP",
            "MSTP",
            "UNKNOWN"
          ]
        },
        "bridgeId": {
          "type": "string",
          "minLength": 1
        },
        "rootBridgeId": {
          "type": "string",
          "minLength": 1
        },
        "rootPathCost": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "stpPortEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "role",
        "state"
      ],
      "properties": {
        "interface": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": "string",
          "enum": [
            "ROOT",
            "DESIGNATED",
            "ALTERNATE",
            "BACKUP",
            "DISABLED",
            "UNKNOWN"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "FORWARDING",
            "BLOCKING",
            "DISCARDING",
            "LEARNING",
            "LISTENING",
            "DISABLED",
            "UNKNOWN"
          ]
        },
        "bpdu": {
          "type": "string",
          "enum": [
            "SEND",
            "RECEIVE",
            "NONE",
            "UNKNOWN"
          ]
        }
      }
    },
    "conntrackEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "destination",
        "protocol",
        "state"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "enabled": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "$ref": "#/$defs/id"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "tcp",
            "udp",
            "icmp"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "state": {
          "type": "string",
          "enum": [
            "NEW",
            "ESTABLISHED",
            "RELATED",
            "INVALID",
            "UNKNOWN"
          ]
        }
      }
    },
    "conntrackTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "entries"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conntrackEntry"
          }
        }
      }
    }
  }
}
