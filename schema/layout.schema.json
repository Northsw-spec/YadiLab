{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:app:schema:layout:0.1.0",
  "title": "Scenario Layout Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatId",
    "schemaVersion",
    "scenarioId",
    "engine",
    "nodes"
  ],
  "properties": {
    "formatId": {
      "const": "infrastructure-cyber-lab.layout"
    },
    "schemaVersion": {
      "$ref": "#/$defs/semver"
    },
    "scenarioId": {
      "$ref": "#/$defs/id"
    },
    "engine": {
      "const": "elk.layered"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layoutNode"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "layoutNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "parent": {
          "$ref": "#/$defs/id"
        },
        "manualOverride": {
          "type": "boolean"
        }
      }
    }
  }
}
