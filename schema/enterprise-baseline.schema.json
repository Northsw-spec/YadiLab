{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:app:schema:enterprise-baseline:0.2.0",
  "title": "Normalized Enterprise Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatId",
    "schemaVersion",
    "modelVersion",
    "baselineId",
    "baselineIdentity",
    "importContract",
    "sources",
    "provenance",
    "entities",
    "relationships",
    "facts"
  ],
  "properties": {
    "formatId": {
      "const": "infrastructure-cyber-lab.enterprise-baseline"
    },
    "schemaVersion": {
      "$ref": "#/$defs/semver"
    },
    "modelVersion": {
      "$ref": "#/$defs/semver"
    },
    "baselineId": {
      "$ref": "#/$defs/id"
    },
    "baselineIdentity": {
      "$ref": "#/$defs/sha256"
    },
    "importContract": {
      "$ref": "#/$defs/importContract"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provenance"
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "jsonValue": {},
    "valueType": {
      "type": "string",
      "enum": [
        "boolean",
        "integer",
        "number",
        "string",
        "ipv4",
        "ipv6",
        "cidr",
        "mac",
        "port",
        "protocol",
        "reference",
        "list",
        "map"
      ]
    },
    "provenanceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "importContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "mapping",
        "options",
        "conflictResolutions"
      ],
      "properties": {
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
            },
            "version": {
              "$ref": "#/$defs/semver"
            }
          }
        },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profileId",
            "version",
            "sha256"
          ],
          "properties": {
            "profileId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
            },
            "version": {
              "$ref": "#/$defs/semver"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        "conflictResolutions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resolutionId",
              "code",
              "choice"
            ],
            "properties": {
              "resolutionId": {
                "$ref": "#/$defs/id"
              },
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              },
              "choice": {
                "$ref": "#/$defs/jsonValue"
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "mediaType",
        "sha256",
        "byteSize"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^src_[0-9a-f]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 0
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "sheet",
            "row",
            "column"
          ],
          "properties": {
            "kind": {
              "const": "table-cell"
            },
            "sheet": {
              "type": "string",
              "minLength": 1
            },
            "row": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "row"
          ],
          "properties": {
            "kind": {
              "const": "record-row"
            },
            "table": {
              "type": "string",
              "minLength": 1
            },
            "row": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "pointer"
          ],
          "properties": {
            "kind": {
              "const": "json-pointer"
            },
            "pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "nodeId"
          ],
          "properties": {
            "kind": {
              "const": "graph-node"
            },
            "nodeId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "description"
          ],
          "properties": {
            "kind": {
              "const": "source-level"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenanceId",
        "sourceRef",
        "locator"
      ],
      "properties": {
        "provenanceId": {
          "$ref": "#/$defs/id"
        },
        "sourceRef": {
          "type": "string",
          "pattern": "^src_[0-9a-f]{64}$"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "rawValueHash": {
          "$ref": "#/$defs/sha256"
        },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mappingId",
            "class"
          ],
          "properties": {
            "mappingId": {
              "$ref": "#/$defs/id"
            },
            "class": {
              "type": "string",
              "enum": [
                "EXACT",
                "ALIAS",
                "USER_MAPPED",
                "DETERMINISTIC_INFERENCE"
              ]
            }
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityId",
        "entityType",
        "label"
      ],
      "properties": {
        "entityId": {
          "$ref": "#/$defs/id"
        },
        "entityType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "siteRef": {
          "$ref": "#/$defs/id"
        },
        "zoneRef": {
          "$ref": "#/$defs/id"
        },
        "provenanceRefs": {
          "$ref": "#/$defs/provenanceRefs"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationshipId",
        "relationshipType",
        "fromRef",
        "toRef",
        "state",
        "provenanceRefs"
      ],
      "properties": {
        "relationshipId": {
          "$ref": "#/$defs/id"
        },
        "relationshipType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
        },
        "fromRef": {
          "$ref": "#/$defs/id"
        },
        "toRef": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "type": "string",
          "enum": [
            "KNOWN",
            "UNKNOWN",
            "CONFLICTING",
            "INFERRED"
          ]
        },
        "provenanceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "fact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "factId",
            "subjectRef",
            "path",
            "valueType",
            "state",
            "value",
            "provenanceRefs"
          ],
          "properties": {
            "factId": {
              "$ref": "#/$defs/id"
            },
            "subjectRef": {
              "$ref": "#/$defs/id"
            },
            "path": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
            },
            "valueType": {
              "$ref": "#/$defs/valueType"
            },
            "state": {
              "const": "KNOWN"
            },
            "value": {
              "$ref": "#/$defs/jsonValue"
            },
            "provenanceRefs": {
              "$ref": "#/$defs/provenanceRefs"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "factId",
            "subjectRef",
            "path",
            "valueType",
            "state",
            "value",
            "inference"
          ],
          "properties": {
            "factId": {
              "$ref": "#/$defs/id"
            },
            "subjectRef": {
              "$ref": "#/$defs/id"
            },
            "path": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
            },
            "valueType": {
              "$ref": "#/$defs/valueType"
            },
            "state": {
              "const": "INFERRED"
            },
            "value": {
              "$ref": "#/$defs/jsonValue"
            },
            "provenanceRefs": {
              "$ref": "#/$defs/provenanceRefs"
            },
            "inference": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ruleId",
                "ruleVersion",
                "inputFactRefs"
              ],
              "properties": {
                "ruleId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
                },
                "ruleVersion": {
                  "$ref": "#/$defs/semver"
                },
                "inputFactRefs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "factId",
            "subjectRef",
            "path",
            "valueType",
            "state"
          ],
          "properties": {
            "factId": {
              "$ref": "#/$defs/id"
            },
            "subjectRef": {
              "$ref": "#/$defs/id"
            },
            "path": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
            },
            "valueType": {
              "$ref": "#/$defs/valueType"
            },
            "state": {
              "const": "UNKNOWN"
            },
            "reasonCode": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
            },
            "provenanceRefs": {
              "$ref": "#/$defs/provenanceRefs"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "factId",
            "subjectRef",
            "path",
            "valueType",
            "state"
          ],
          "properties": {
            "factId": {
              "$ref": "#/$defs/id"
            },
            "subjectRef": {
              "$ref": "#/$defs/id"
            },
            "path": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
            },
            "valueType": {
              "$ref": "#/$defs/valueType"
            },
            "state": {
              "const": "NOT_APPLICABLE"
            },
            "reasonCode": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
            },
            "provenanceRefs": {
              "$ref": "#/$defs/provenanceRefs"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "factId",
            "subjectRef",
            "path",
            "valueType",
            "state",
            "reasonCode",
            "provenanceRefs"
          ],
          "properties": {
            "factId": {
              "$ref": "#/$defs/id"
            },
            "subjectRef": {
              "$ref": "#/$defs/id"
            },
            "path": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
            },
            "valueType": {
              "$ref": "#/$defs/valueType"
            },
            "state": {
              "const": "INVALID"
            },
            "reasonCode": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
            },
            "rawValue": {
              "$ref": "#/$defs/jsonValue"
            },
            "provenanceRefs": {
              "$ref": "#/$defs/provenanceRefs"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "factId",
            "subjectRef",
            "path",
            "valueType",
            "state",
            "candidates"
          ],
          "properties": {
            "factId": {
              "$ref": "#/$defs/id"
            },
            "subjectRef": {
              "$ref": "#/$defs/id"
            },
            "path": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
            },
            "valueType": {
              "$ref": "#/$defs/valueType"
            },
            "state": {
              "const": "CONFLICTING"
            },
            "reasonCode": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
            },
            "candidates": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "provenanceRefs"
                ],
                "properties": {
                  "value": {
                    "$ref": "#/$defs/jsonValue"
                  },
                  "provenanceRefs": {
                    "$ref": "#/$defs/provenanceRefs"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mergePlanSha256",
        "parents",
        "resolutions"
      ],
      "properties": {
        "kind": {
          "const": "REIMPORT_MERGE"
        },
        "mergePlanSha256": {
          "$ref": "#/$defs/sha256"
        },
        "parents": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "baselineIdentity"
            ],
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "ANCESTOR",
                  "CURRENT",
                  "INCOMING"
                ]
              },
              "baselineIdentity": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "resolutions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entryKey",
              "choice"
            ],
            "properties": {
              "entryKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "choice": {
                "type": "string",
                "enum": [
                  "CURRENT",
                  "INCOMING",
                  "DELETE"
                ]
              }
            }
          }
        }
      }
    }
  }
}
