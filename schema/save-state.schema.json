{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:app:schema:save-state:0.1.0",
  "title": "Runtime Save State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatId",
    "schemaVersion",
    "scenarioHash",
    "engineVersion",
    "stateRevision",
    "clock",
    "resourceState",
    "completedObjectives",
    "evidence"
  ],
  "properties": {
    "formatId": {
      "const": "infrastructure-cyber-lab.save"
    },
    "schemaVersion": {
      "$ref": "#/$defs/semver"
    },
    "scenarioHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "engineVersion": {
      "$ref": "#/$defs/semver"
    },
    "stateRevision": {
      "type": "integer",
      "minimum": 0
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "tick"
      ],
      "properties": {
        "mode": {
          "const": "virtual"
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resourceState": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "completedObjectives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "truth": {
      "type": "string",
      "enum": [
        "TRUE",
        "FALSE",
        "UNKNOWN"
      ]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource"
      ],
      "properties": {
        "resource": {
          "$ref": "#/$defs/id"
        },
        "port": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      }
    },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "rules"
          ],
          "properties": {
            "op": {
              "const": "all"
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/rule"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "rules"
          ],
          "properties": {
            "op": {
              "const": "any"
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/rule"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "rule"
          ],
          "properties": {
            "op": {
              "const": "not"
            },
            "rule": {
              "$ref": "#/$defs/rule"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "target",
            "path",
            "value"
          ],
          "properties": {
            "op": {
              "const": "equals"
            },
            "target": {
              "$ref": "#/$defs/id"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "from",
            "to"
          ],
          "properties": {
            "op": {
              "const": "reachable"
            },
            "from": {
              "$ref": "#/$defs/id"
            },
            "to": {
              "$ref": "#/$defs/id"
            },
            "protocol": {
              "type": "string",
              "enum": [
                "tcp",
                "udp",
                "icmp",
                "any"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "subject",
            "group"
          ],
          "properties": {
            "op": {
              "const": "member_of"
            },
            "subject": {
              "$ref": "#/$defs/id"
            },
            "group": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "subject",
            "resource",
            "permission"
          ],
          "properties": {
            "op": {
              "const": "has_permission"
            },
            "subject": {
              "$ref": "#/$defs/id"
            },
            "resource": {
              "$ref": "#/$defs/id"
            },
            "permission": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "target",
            "service"
          ],
          "properties": {
            "op": {
              "const": "service_enabled"
            },
            "target": {
              "$ref": "#/$defs/id"
            },
            "service": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "test",
            "expected"
          ],
          "properties": {
            "op": {
              "const": "test_result"
            },
            "test": {
              "$ref": "#/$defs/id"
            },
            "expected": {
              "$ref": "#/$defs/truth"
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "testId",
        "outcome",
        "summary"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "testId": {
          "$ref": "#/$defs/id"
        },
        "outcome": {
          "$ref": "#/$defs/truth"
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
