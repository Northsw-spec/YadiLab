{
  "formatId": "infrastructure-cyber-lab.scenario-source",
  "schemaVersion": "0.1.0",
  "scenarioId": "guided_win_gateway",
  "metadata": {
    "title": "Windows · fel standard-gateway",
    "description": "Guided troubleshooting curriculum Wave 1 · routing.",
    "language": "sv",
    "authors": [
      "Foundation curriculum"
    ],
    "tags": [
      "guided-lab",
      "wave1",
      "windows",
      "routing"
    ],
    "briefing": "Klienten når lokala nätet men inte servern i ett annat subnät. Samla routing- och probe-evidens innan du gör en åtgärd."
  },
  "requires": {
    "capabilities": [
      {
        "id": "core.network",
        "version": "^1.0.0"
      },
      {
        "id": "core.windows",
        "version": "^1.0.0"
      }
    ],
    "profiles": []
  },
  "zones": [
    {
      "id": "client_zone",
      "label": "Client zone",
      "kind": "lan"
    },
    {
      "id": "transit_zone",
      "label": "Transit",
      "kind": "lan"
    },
    {
      "id": "server_zone",
      "label": "Server zone",
      "kind": "server"
    }
  ],
  "resources": [
    {
      "id": "client1",
      "type": "windows.workstation",
      "label": "Windows client",
      "zone": "client_zone",
      "properties": {
        "defaultGateway": "10.78.1.254",
        "dnsServers": [],
        "dhcp": {
          "enabled": true
        },
        "aclDefaultAction": "allow",
        "networkProfile": "private"
      },
      "interfaces": [
        {
          "id": "eth0",
          "label": "Ethernet",
          "addresses": [
            "10.78.1.20/24"
          ]
        }
      ]
    },
    {
      "id": "r1",
      "type": "network.router",
      "label": "Router",
      "zone": "transit_zone",
      "properties": {
        "routes": [
          {
            "id": "to-server",
            "destination": "server1",
            "via": "server1",
            "action": "forward",
            "enabled": true
          }
        ]
      },
      "interfaces": [
        {
          "id": "lan",
          "label": "LAN",
          "addresses": [
            "10.78.1.1/24",
            "10.78.101.1/24"
          ]
        }
      ]
    },
    {
      "id": "server1",
      "type": "windows.server",
      "label": "Windows server",
      "zone": "server_zone",
      "properties": {
        "defaultGateway": "10.78.101.1",
        "aclDefaultAction": "allow",
        "rdp": {
          "enabled": true,
          "port": 3389,
          "protocol": "tcp"
        }
      },
      "interfaces": [
        {
          "id": "eth0",
          "label": "Ethernet",
          "addresses": [
            "10.78.101.80/24"
          ]
        }
      ]
    }
  ],
  "connections": [
    {
      "id": "client_r1",
      "kind": "network",
      "from": {
        "resource": "client1"
      },
      "to": {
        "resource": "r1"
      },
      "properties": {}
    },
    {
      "id": "r1_server",
      "kind": "network",
      "from": {
        "resource": "r1"
      },
      "to": {
        "resource": "server1"
      },
      "properties": {}
    }
  ],
  "tests": [
    {
      "id": "baseline_reachability",
      "type": "network.reachability",
      "params": {
        "from": "client1",
        "to": "server1",
        "protocol": "icmp"
      },
      "expectedInitial": "FALSE",
      "expectedSolved": "TRUE"
    }
  ],
  "findings": [],
  "objectives": [
    {
      "id": "restore_expected_state",
      "title": "Återställ förväntad funktion utan att ändra mer än nödvändigt",
      "category": "troubleshooting",
      "required": true,
      "condition": {
        "op": "equals",
        "target": "client1",
        "path": "properties.defaultGateway",
        "value": "10.78.1.1"
      }
    }
  ],
  "troubleshootingObjectives": [
    {
      "id": "collect_required_evidence",
      "title": "Samla evidens före åtgärd",
      "description": "Följ den transparenta evidenskedjan och formulera sedan din egen hypotes.",
      "required": true,
      "evidenceOrder": "ordered",
      "requirements": [
        {
          "id": "route_state",
          "label": "Dokumentera klientens routingtabell",
          "kind": "observation",
          "category": "routing",
          "targetId": "client1"
        },
        {
          "id": "offlink_failure",
          "label": "Bevisa att klienten inte når servern över ICMP",
          "kind": "active_probe",
          "category": "connectivity",
          "sourceId": "client1",
          "destinationId": "server1",
          "protocol": "icmp",
          "truth": "FALSE"
        }
      ]
    }
  ],
  "completion": {
    "op": "equals",
    "target": "client1",
    "path": "properties.defaultGateway",
    "value": "10.78.1.1"
  },
  "hints": [
    {
      "level": 1,
      "text": "Börja med att observera aktuell konfiguration och bevisa sedan felet med en modellerad probe."
    },
    {
      "level": 2,
      "text": "Spara före-evidens i notebooken innan du provar en typed remediation."
    }
  ],
  "notes": [],
  "canonicalSolution": {
    "operations": [
      {
        "op": "set",
        "target": "client1",
        "path": "properties.defaultGateway",
        "value": "10.78.1.1"
      }
    ]
  },
  "layoutHints": [
    {
      "target": "client1",
      "rank": 1
    },
    {
      "target": "r1",
      "rank": 2
    },
    {
      "target": "server1",
      "rank": 3
    }
  ]
}
