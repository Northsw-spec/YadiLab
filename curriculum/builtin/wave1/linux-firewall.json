{
  "formatId": "infrastructure-cyber-lab.scenario-source",
  "schemaVersion": "0.1.0",
  "scenarioId": "guided_linux_firewall",
  "metadata": {
    "title": "Linux · blockerande nftables-policy",
    "description": "Guided troubleshooting curriculum Wave 1 · firewall.",
    "language": "sv",
    "authors": [
      "Foundation curriculum"
    ],
    "tags": [
      "guided-lab",
      "wave1",
      "linux",
      "firewall"
    ],
    "briefing": "Topologin är korrekt men klientens modeled default-policy blockerar trafik. Samla firewall- och connectivity-evidens."
  },
  "requires": {
    "capabilities": [
      {
        "id": "core.network",
        "version": "^1.0.0"
      },
      {
        "id": "core.linux",
        "version": "^1.0.0"
      }
    ],
    "profiles": []
  },
  "zones": [
    {
      "id": "client_zone",
      "label": "Client zone",
      "kind": "lan"
    },
    {
      "id": "transit_zone",
      "label": "Transit",
      "kind": "lan"
    },
    {
      "id": "server_zone",
      "label": "Server zone",
      "kind": "server"
    }
  ],
  "resources": [
    {
      "id": "client1",
      "type": "linux.workstation",
      "label": "Linux client",
      "zone": "client_zone",
      "properties": {
        "defaultGateway": "10.78.7.1",
        "dnsServers": [],
        "dhcp": {
          "enabled": true
        },
        "aclDefaultAction": "deny",
        "NetworkManager": {
          "enabled": true
        },
        "systemdResolved": {
          "enabled": true
        }
      },
      "interfaces": [
        {
          "id": "eth0",
          "label": "eth0",
          "addresses": [
            "10.78.7.20/24"
          ]
        }
      ]
    },
    {
      "id": "r1",
      "type": "network.router",
      "label": "Router",
      "zone": "transit_zone",
      "properties": {
        "routes": [
          {
            "id": "to-server",
            "destination": "server1",
            "via": "server1",
            "action": "forward",
            "enabled": true
          }
        ]
      },
      "interfaces": [
        {
          "id": "lan",
          "label": "LAN",
          "addresses": [
            "10.78.7.1/24",
            "10.78.107.1/24"
          ]
        }
      ]
    },
    {
      "id": "server1",
      "type": "linux.server",
      "label": "Linux server",
      "zone": "server_zone",
      "properties": {
        "defaultGateway": "10.78.107.1",
        "aclDefaultAction": "allow",
        "ssh": {
          "enabled": true,
          "port": 22,
          "protocol": "tcp"
        }
      },
      "interfaces": [
        {
          "id": "eth0",
          "label": "eth0",
          "addresses": [
            "10.78.107.80/24"
          ]
        }
      ]
    }
  ],
  "connections": [
    {
      "id": "client_r1",
      "kind": "network",
      "from": {
        "resource": "client1"
      },
      "to": {
        "resource": "r1"
      },
      "properties": {}
    },
    {
      "id": "r1_server",
      "kind": "network",
      "from": {
        "resource": "r1"
      },
      "to": {
        "resource": "server1"
      },
      "properties": {}
    }
  ],
  "tests": [
    {
      "id": "baseline_reachability",
      "type": "network.reachability",
      "params": {
        "from": "client1",
        "to": "server1",
        "protocol": "icmp"
      },
      "expectedInitial": "FALSE",
      "expectedSolved": "TRUE"
    }
  ],
  "findings": [],
  "objectives": [
    {
      "id": "restore_expected_state",
      "title": "Återställ förväntad funktion utan att ändra mer än nödvändigt",
      "category": "troubleshooting",
      "required": true,
      "condition": {
        "op": "equals",
        "target": "client1",
        "path": "properties.aclDefaultAction",
        "value": "allow"
      }
    }
  ],
  "troubleshootingObjectives": [
    {
      "id": "collect_required_evidence",
      "title": "Samla evidens före åtgärd",
      "description": "Följ den transparenta evidenskedjan och formulera sedan din egen hypotes.",
      "required": true,
      "evidenceOrder": "ordered",
      "requirements": [
        {
          "id": "firewall_state",
          "label": "Dokumentera klientens firewall-policy",
          "kind": "observation",
          "category": "firewall",
          "targetId": "client1"
        },
        {
          "id": "connectivity_failure",
          "label": "Bevisa att trafik till servern blockeras",
          "kind": "active_probe",
          "category": "connectivity",
          "sourceId": "client1",
          "destinationId": "server1",
          "protocol": "icmp",
          "truth": "FALSE"
        }
      ]
    }
  ],
  "completion": {
    "op": "equals",
    "target": "client1",
    "path": "properties.aclDefaultAction",
    "value": "allow"
  },
  "hints": [
    {
      "level": 1,
      "text": "Börja med att observera aktuell konfiguration och bevisa sedan felet med en modellerad probe."
    },
    {
      "level": 2,
      "text": "Spara före-evidens i notebooken innan du provar en typed remediation."
    }
  ],
  "notes": [],
  "canonicalSolution": {
    "operations": [
      {
        "op": "set",
        "target": "client1",
        "path": "properties.aclDefaultAction",
        "value": "allow"
      }
    ]
  },
  "layoutHints": [
    {
      "target": "client1",
      "rank": 1
    },
    {
      "target": "r1",
      "rank": 2
    },
    {
      "target": "server1",
      "rank": 3
    }
  ]
}
