{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": [
    "core-model/src/**/*.ts",
    "renderer/src/**/*.ts",
    "versioning/src/**/*.ts",
    "asset-library/src/**/*.ts",
    "capability-packs/src/**/*.ts",
    "validator/src/**/*.ts",
    "compiler/src/**/*.ts",
    "enterprise-model/src/**/*.ts",
    "enterprise-import/src/**/*.ts",
    "enterprise-projection/src/**/*.ts",
    "engine/src/**/*.ts",
    "observation-engine/src/**/*.ts",
    "package-io/src/**/*.ts",
    "layout/src/**/*.ts",
    "cli/src/**/*.ts",
    "cli/src/**/*.d.ts",
    "certification/src/**/*.ts",
    "ui/src/**/*.ts"
  ]
}
